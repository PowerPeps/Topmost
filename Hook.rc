#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    TOPMOST_VER_MAJOR, TOPMOST_VER_MINOR, TOPMOST_VER_PATCH, TOPMOST_VER_BUILD
 PRODUCTVERSION TOPMOST_VER_MAJOR, TOPMOST_VER_MINOR, TOPMOST_VER_PATCH, TOPMOST_VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Topmost"
            VALUE "FileDescription",  "Topmost - window menu hook"
            VALUE "FileVersion",      TOPMOST_VER_STRING
            VALUE "InternalName",     "TopmostHook"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "ProductName",      "Topmost"
            VALUE "ProductVersion",   TOPMOST_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
